generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rol {
  id_rol     Int       @id @default(autoincrement())
  nombre_rol String    @unique @db.VarChar(60)
  usuarios   Usuario[]

  @@map("ROL")
}

model Usuario {
  id_usuario           Int                  @id @default(autoincrement())
  id_rol               Int
  id_supervisor        Int?
  nombres              String               @db.VarChar(100)
  apellidos            String               @db.VarChar(100)
  correo               String               @unique @db.VarChar(254)
  contrasena_hash      String               @db.VarChar(255)
  telefono             String?              @db.VarChar(20)
  rol                  Rol                  @relation(fields: [id_rol], references: [id_rol])
  supervisor           Usuario?             @relation("JerarquiaUsuarios", fields: [id_supervisor], references: [id_usuario])
  subordinados         Usuario[]            @relation("JerarquiaUsuarios")
  productosAdmin       Producto[]           @relation("AdministraProducto")
  lotesRegistrados     LoteIngrediente[]    @relation("RegistraLote")
  pedidos              Pedido[]
  solicitudesProveedor SolicitudProveedor[] @relation("RegistraSolicitudProveedor")
  pagosValidados       Pago[]               @relation("ValidaPago")
  ordenesDespachadas   OrdenSalida[]        @relation("DespachaOrden")

  @@index([id_rol])
  @@index([id_supervisor])
  @@map("USUARIO")
}

model CategoriaProducto {
  id_categoria     Int        @id @default(autoincrement())
  nombre_categoria String     @unique @db.VarChar(80)
  productos        Producto[]

  @@map("CATEGORIA_PRODUCTO")
}

model Producto {
  id_producto         Int               @id @default(autoincrement())
  id_categoria        Int
  id_usuario_admin    Int
  nombre              String            @unique @db.VarChar(120)
  precio_venta_actual Decimal           @db.Decimal(10, 2)
  disponible          Boolean           @default(true)
  categoria           CategoriaProducto @relation(fields: [id_categoria], references: [id_categoria])
  administrador       Usuario           @relation("AdministraProducto", fields: [id_usuario_admin], references: [id_usuario])
  recetas             Receta[]
  detallesPedido      DetallePedido[]

  @@index([id_categoria])
  @@index([id_usuario_admin])
  @@map("PRODUCTO")
}

model Ingrediente {
  id_ingrediente       Int                  @id @default(autoincrement())
  nombre               String               @unique @db.VarChar(120)
  unidad_medida        String               @db.VarChar(30)
  stock_minimo         Decimal              @default(0) @db.Decimal(10, 3)
  lotes                LoteIngrediente[]
  recetas              Receta[]
  proveedores          Proveedor[]
  solicitudesProveedor SolicitudProveedor[]

  @@map("INGREDIENTE")
}

model Proveedor {
  id_proveedor        Int                  @id @default(autoincrement())
  nombre              String               @db.VarChar(120)
  telefono            String               @db.VarChar(20)
  id_ingrediente      Int
  cantidad_por_pedido Decimal              @db.Decimal(10, 3)
  ingrediente         Ingrediente          @relation(fields: [id_ingrediente], references: [id_ingrediente])
  solicitudes         SolicitudProveedor[]

  @@index([id_ingrediente])
  @@map("PROVEEDOR")
}

model LoteIngrediente {
  id_lote             Int         @id @default(autoincrement())
  id_ingrediente      Int
  id_usuario_admin    Int
  codigo_lote         String      @unique @db.VarChar(80)
  fecha_ingreso       DateTime    @db.Timestamp(0)
  fecha_vencimiento   DateTime    @db.Date
  cantidad_inicial    Decimal     @db.Decimal(10, 3)
  cantidad_disponible Decimal     @db.Decimal(10, 3)
  ingrediente         Ingrediente @relation(fields: [id_ingrediente], references: [id_ingrediente])
  administrador       Usuario     @relation("RegistraLote", fields: [id_usuario_admin], references: [id_usuario])

  @@index([id_ingrediente])
  @@index([id_usuario_admin])
  @@index([fecha_vencimiento])
  @@map("LOTE_INGREDIENTE")
}

model SolicitudProveedor {
  id_solicitud     Int         @id @default(autoincrement())
  id_proveedor     Int
  id_ingrediente   Int
  id_usuario_admin Int
  cantidad         Decimal     @db.Decimal(10, 3)
  estado           String      @default("Pendiente") @db.VarChar(20)
  fecha_solicitud  DateTime    @default(now()) @db.Timestamp(0)
  fecha_recepcion  DateTime?   @db.Timestamp(0)
  proveedor        Proveedor   @relation(fields: [id_proveedor], references: [id_proveedor])
  ingrediente      Ingrediente @relation(fields: [id_ingrediente], references: [id_ingrediente])
  administrador    Usuario     @relation("RegistraSolicitudProveedor", fields: [id_usuario_admin], references: [id_usuario])

  @@index([id_proveedor])
  @@index([id_ingrediente])
  @@index([id_usuario_admin])
  @@index([estado, fecha_solicitud])
  @@map("SOLICITUD_PROVEEDOR")
}

model Receta {
  id_receta          Int         @id @default(autoincrement())
  id_producto        Int
  id_ingrediente     Int
  cantidad_necesaria Decimal     @db.Decimal(10, 3)
  producto           Producto    @relation(fields: [id_producto], references: [id_producto])
  ingrediente        Ingrediente @relation(fields: [id_ingrediente], references: [id_ingrediente])

  @@unique([id_producto, id_ingrediente])
  @@index([id_ingrediente])
  @@map("RECETA")
}

model TipoPedido {
  id_tipo_pedido Int      @id @default(autoincrement())
  descripcion    String   @unique @db.VarChar(80)
  pedidos        Pedido[]

  @@map("TIPO_PEDIDO")
}

model EstadoPedido {
  id_estado_pedido Int      @id @default(autoincrement())
  descripcion      String   @unique @db.VarChar(80)
  pedidos          Pedido[]

  @@map("ESTADO_PEDIDO")
}

model Pedido {
  id_pedido         Int             @id @default(autoincrement())
  id_usuario        Int
  id_tipo_pedido    Int
  id_estado_pedido  Int
  fecha_hora        DateTime        @default(now()) @db.Timestamp(0)
  total             Decimal         @db.Decimal(10, 2)
  direccion_entrega String?         @db.VarChar(255)
  cliente           Usuario         @relation(fields: [id_usuario], references: [id_usuario])
  tipo              TipoPedido      @relation(fields: [id_tipo_pedido], references: [id_tipo_pedido])
  estado            EstadoPedido    @relation(fields: [id_estado_pedido], references: [id_estado_pedido])
  detalles          DetallePedido[]
  pago              Pago?
  factura           Factura?
  ordenSalida       OrdenSalida?

  @@index([id_usuario])
  @@index([id_tipo_pedido])
  @@index([id_estado_pedido])
  @@index([fecha_hora])
  @@map("PEDIDO")
}

model DetallePedido {
  id_detalle                Int      @id @default(autoincrement())
  id_pedido                 Int
  id_producto               Int
  cantidad                  Int
  precio_unitario_historico Decimal  @db.Decimal(10, 2)
  pedido                    Pedido   @relation(fields: [id_pedido], references: [id_pedido])
  producto                  Producto @relation(fields: [id_producto], references: [id_producto])

  @@index([id_pedido])
  @@index([id_producto])
  @@map("DETALLE_PEDIDO")
}

model MetodoPago {
  id_metodo_pago Int    @id @default(autoincrement())
  descripcion    String @unique @db.VarChar(80)
  pagos          Pago[]

  @@map("METODO_PAGO")
}

model Pago {
  id_pago          Int        @id @default(autoincrement())
  id_pedido        Int        @unique
  id_metodo_pago   Int
  id_usuario_admin Int?
  monto            Decimal    @db.Decimal(10, 2)
  referencia_banco String?    @db.VarChar(120)
  fecha_pago       DateTime   @default(now()) @db.Timestamp(0)
  pedido           Pedido     @relation(fields: [id_pedido], references: [id_pedido])
  metodo           MetodoPago @relation(fields: [id_metodo_pago], references: [id_metodo_pago])
  administrador    Usuario?   @relation("ValidaPago", fields: [id_usuario_admin], references: [id_usuario])

  @@index([id_metodo_pago])
  @@index([id_usuario_admin])
  @@map("PAGO")
}

model Factura {
  id_factura           Int      @id @default(autoincrement())
  id_pedido            Int      @unique
  fecha_emision        DateTime @default(now()) @db.Timestamp(0)
  ruc_cedula_cliente   String   @db.VarChar(20)
  razon_social         String   @db.VarChar(150)
  subtotal_facturado   Decimal  @db.Decimal(10, 2)
  impuestos_facturados Decimal  @db.Decimal(10, 2)
  total_facturado      Decimal  @db.Decimal(10, 2)
  pedido               Pedido   @relation(fields: [id_pedido], references: [id_pedido])

  @@map("FACTURA")
}

model EstadoOrden {
  id_estado_orden Int           @id @default(autoincrement())
  descripcion     String        @unique @db.VarChar(80)
  ordenesSalida   OrdenSalida[]

  @@map("ESTADO_ORDEN")
}

model OrdenSalida {
  id_orden_salida     Int         @id @default(autoincrement())
  id_pedido           Int         @unique
  id_usuario_despacha Int?
  id_estado_orden     Int
  fecha_despacho      DateTime?   @db.Timestamp(0)
  pedido              Pedido      @relation(fields: [id_pedido], references: [id_pedido])
  despachador         Usuario?    @relation("DespachaOrden", fields: [id_usuario_despacha], references: [id_usuario])
  estado              EstadoOrden @relation(fields: [id_estado_orden], references: [id_estado_orden])

  @@index([id_usuario_despacha])
  @@index([id_estado_orden])
  @@map("ORDEN_SALIDA")
}
